---
/** First screen: words on black, then the lines take shape (hero.css). */
---
<section class="hero" aria-labelledby="masthead-title">
  <div class="container hero__inner">
    <p class="hero__byline">Yasaman Aminian</p>
    <div class="hero__rules hero__rules--top" aria-hidden="true"><span class="rule rule--5"></span><span class="rule rule--15"></span></div>
    <h1 class="hero__title" id="masthead-title"><span class="mask"><span class="rise"><span class="type-slot"><span class="type-slot__ghost">Product</span><span class="type-word" aria-hidden="true"></span></span> Design</span></span> <span class="mask"><span class="rise">Portfolio</span></span></h1>
    <div class="hero__rules hero__rules--bottom" aria-hidden="true"><span class="rule rule--15"></span><span class="rule rule--5"></span></div>
    <div class="hero__disciplines">
      <span>UX design</span>
      <span>Service design</span>
      <span>UI design</span>
    </div>
    <span class="hairline" aria-hidden="true"></span>
    <dl class="hero__spec">
      <div><dt>Location</dt><dd>United Kingdom</dd></div>
      <div><dt>Status</dt><dd><span class="status-dot" aria-hidden="true"></span>Available</dd></div>
    </dl>
    <span class="hairline hairline--2" aria-hidden="true"></span>
    <a class="scroll-cue" href="#edition" data-ga-event="nav_click" data-ga-label="scroll_cue">Scroll to unfold<span class="scroll-cue__line" aria-hidden="true"></span></a>
  </div>
</section>
