---
/** Home top bar: Work / About and the inverted Contact button. */
---
<header class="topbar">
  <nav class="container topbar__inner" aria-label="Primary">
    <div class="topbar__links">
      <a href="#work" data-ga-event="nav_click" data-ga-label="work"><span class="roll" data-text="Work"><span>Work</span></span></a>
      <a href="#about" data-ga-event="nav_click" data-ga-label="about"><span class="roll" data-text="About"><span>About</span></span></a>
    </div>
    <a class="btn btn--invert topbar__cta" href="#contact" data-ga-event="nav_click" data-ga-label="contact"><span class="roll" data-text="Contact"><span>Contact</span></span><span class="btn__dot" aria-hidden="true"></span></a>
  </nav>
</header>
